# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# kicad ingestion data (cloned symbol library — large, regenerable)
/data

# ingestion script reports (machine-generated, regenerable)
/scripts/output

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.codex-run/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# external clones (their own repos — not our code). The data we derive from
# PCBSchemaGen_v2 lives in the checked-in lib/kg-data.ts, so the clone is only
# needed to re-run scripts/build-kg.ts.
/SchGen
/PCBSchemaGen_v2

# Pinned external GPLv3 source clone + verified local JAR/JRE. Recreate with
# `npm run setup:freerouting`; Sirkit talks to it only as a child process.
/vendor/freerouting/
