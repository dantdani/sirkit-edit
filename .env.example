# Copy to .env.local and fill in real values. .env* is gitignored — never
# commit actual keys.

# ─── Server-side AI brains ────────────────────────────────────────────────────
# Never use NEXT_PUBLIC_ for either key. Browser code sends only the provider id.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-4-7)
# SIRKIT_ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI is both an optional reasoning brain and the FIXED embeddings provider.
# The AI Brain selector never changes text-embedding-3-small retrieval.
OPENAI_API_KEY=
# Optional reasoning-model overrides (defaults: GPT-5.6 Sol at high effort).
# Sirkit does not impose an input-context cap; provider/model limits still apply.
# SIRKIT_OPENAI_MODEL=gpt-5.6-sol
# SIRKIT_OPENAI_REASONING_EFFORT=high

# ─── Postgres connection for Drizzle (KiCad parts data layer) ─────────────────
# Use the Supabase Session Pooler URI (IPv4-compatible). The direct
# db.<ref>.supabase.co host is IPv6-only and fails on IPv4-only networks.
DATABASE_URL=

# ─── Supabase client (future app-level auth/session use) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Freerouting (PCB one-click autoroute, Stage 9) ───────────────────────────
# Install the pinned local CLI + private Java 25 runtime once with:
#   npm run setup:freerouting
# No Freerouting hosted API or API key is used. These optional server-side
# overrides are only for operators who manage their own JAR/Java installation.
# FREEROUTING_JAR=C:\path\to\freerouting.jar
# FREEROUTING_JAVA=C:\path\to\java.exe
# JAVA_HOME=C:\path\to\jdk

# ─── kicad-cli (PCB fab bundle export, Stage 14) ──────────────────────────────
# Absolute path to KiCad's kicad-cli binary (8.x or newer; e.g.
# C:\Program Files\KiCad\10.0\bin\kicad-cli.exe). /api/pcb/export/gerbers spawns
# it to plot Gerbers + Excellon drills. Defaults to `kicad-cli` on PATH; if
# missing, "Send to fab" fails cleanly with kicad-cli-missing.
KICAD_CLI=

# [B22-A3] The diagnostic ngspice runner runs ONLY a pinned install (OD-135): the
# install folder (the Spice64 folder of the ngspice Windows build; the runner
# starts its bin/ngspice_con.exe) and that folder's install-tree digest, printed
# by `tsx scripts/print-install-tree-digest.ts <folder>`. Both are required: an
# unpinned or changed install is refused, closed, before any process starts.
# NGSPICE_BIN and PATH no longer choose the binary.
SIRKIT_NGSPICE_INSTALL_ROOT=
SIRKIT_NGSPICE_INSTALL_SHA256=

# Footprint assignment Stage 6 rollout: off | observe | opt_in.
# Observe permits reads/previews. Only opt_in permits exact-plan commits.
SIRKIT_ASSIGNMENT_QUEUE_STAGE6=off

# Durable schematic-to-PCB synchronization rollout:
#   off | observe | opt_in | authoritative_safe_profile
# Every /api/pcb-sync operation (including publish_demo_snapshot) returns 503
# PS_STAGE3_DISABLED while off. Apply additionally requires opt_in or
# authoritative_safe_profile plus the client's explicit opt-in header.
SIRKIT_PCB_SYNC_STAGE3=authoritative_safe_profile

# Server-only bearer secret for trusted source materialization and durable effects.
SIRKIT_WORKFLOW_WORKER_SECRET=

# ─── MCP (B20) ────────────────────────────────────────────────────────────────
# Both MCP surfaces (Sirkit consuming an approved external MCP server, Sirkit
# exposing its own read/propose tools) stay OFF unless the value is exactly 1;
# true, yes and on leave it off. The external allowlist is the reviewed registry
# in app/lib/mcp/server-registry.ts (empty until a reviewed row is added).
# SIRKIT_MCP_ENABLED=
# Comma-separated registry ids forced OFF even though the registry approves them.
# It can only remove servers, never add one.
# SIRKIT_MCP_DISABLED_SERVERS=
# The key Sirkit signs its own MCP access tokens with (B20-B2, POST /api/mcp/token;
# HS256, one hour). 32 to 1 024 bytes, no surrounding whitespace, never the
# worker secret above and never KICAD_HTTP_LIBRARY_TOKEN. Unset means the MCP
# endpoint is not configured (503). The endpoint also needs SIRKIT_EXPECTED_ORIGIN.
# SIRKIT_MCP_TOKEN_SECRET=

# ─── Deployment profile (B24-A1, OD-190) ──────────────────────────────────────
# What this deployment is: development | ci | staging | production, exactly (no
# trim, no case folding). In a production runtime (NODE_ENV=production) only
# staging and production serve sensitive routes; anything else, unset included,
# answers 403 AUTH_PRODUCTION_NOT_CONFIGURED, and SIRKIT_EXPECTED_ORIGIN is then
# required for reads too. A non-production runtime is never blocked by it.
# SIRKIT_DEPLOYMENT_ENV=

# The diagnostic ngspice runner's off-only switch (B24-A1, OD-200): any non-blank
# value refuses every diagnostic run with NGSPICE_DIAGNOSTIC_DISABLED, before any
# digest, directory or process. Unset, empty or blank leaves the runner as it is;
# nothing here can turn simulation on.
# SIRKIT_DIAGNOSTIC_RUNNER_DISABLED=

# ─── Every other name of a declared class the code reads (B24-A2, OD-195) ─────
# Names only, never a value. The census of every name the code reads, each with
# its class, is app/lib/deployment/environment-names.ts. Fixtures, opt-in test
# and live gates, platform names and kicad-cli's own KICAD_CONFIG_HOME are read
# but not declared here; that file gives each class's reason.
#
# Secrets (server-side only; never NEXT_PUBLIC_):
# The KiCad HTTP library's backend token (/api/kicad/v1 answers 503 while unset).
# KICAD_HTTP_LIBRARY_TOKEN=
# Distributor credentials, read by name by the acquisition source registry (B19).
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# MOUSER_API_KEY=
# OCTOPART_API_KEY=
# NEXAR_API_KEY=
# The SchGen cross-verify endpoint's token (HF_TOKEN is read when it is unset).
# SCHGEN_ENDPOINT_TOKEN=
# HF_TOKEN=
# The opt-in real-database qualification's connection string: tests only, never
# a production database (runbook :1044).
# SIRKIT_DB_QUALIFICATION_URL=
#
# Rotation, verification only: put the old value in the _PREVIOUS name and the
# new one in the current name; keep both until every holder has the new value
# (the MCP key at least 3,630 s: a token's lifetime plus the clock skew), then
# unset the _PREVIOUS name - within seven days of the switch at the latest.
# A previous value never signs or issues, and alone it configures nothing.
# After a suspected leak, rotate without it: never put a leaked value in a _PREVIOUS name.
# Replace the current value, leave the _PREVIOUS name unset and update every
# holder at once; the outage until they have the new value is accepted.
# SIRKIT_WORKFLOW_WORKER_SECRET_PREVIOUS=
# KICAD_HTTP_LIBRARY_TOKEN_PREVIOUS=
# SIRKIT_MCP_TOKEN_SECRET_PREVIOUS=
#
# Configuration:
# The deployment's one public origin: https, or http on a loopback host only in
# production, where it is required. It also decides the session cookie's Secure
# flag and Strict-Transport-Security (next.config.ts), at build time.
# SIRKIT_EXPECTED_ORIGIN=
# local_dev (the default) or production; it can only raise a non-production
# runtime to production authentication.
# SIRKIT_AUTH_MODE=
# The older name of the publishable key, read only when that one is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The database pool size (default 8).
# SIRKIT_DB_POOL_MAX=
# Per-role model overrides of the orchestration (unset: every role inherits).
# SIRKIT_ORCHESTRATION_ROLE_MODELS=
# The atomic catalog's governance tenant and project (unset: publication refused).
# SIRKIT_ATOMIC_CATALOG_TENANT_ID=
# SIRKIT_ATOMIC_CATALOG_PROJECT_ID=
# The SchGen cross-verify endpoint (unset: the second opinion is not configured).
# SCHGEN_ENDPOINT_URL=
# Pinned installs and digests of B22's runtime profiles (unset: refused, closed).
# SIRKIT_KICAD_CLI_INSTALL_ROOT=
# SIRKIT_KICAD_CLI_INSTALL_SHA256=
# SIRKIT_FREEROUTING_INSTALL_ROOT=
# SIRKIT_FREEROUTING_INSTALL_SHA256=
# SIRKIT_NGSPICE_OCI_IMAGE=
# SIRKIT_OCI_CLI_PATH=
# SIRKIT_OCI_CLI_SHA256=
#
# Flags, each off or unset by default (app/lib/deployment/flag-inventory.ts):
# The orchestration and the named computations: on only when exactly 1.
# SIRKIT_ORCHESTRATION_ENABLED=
# SIRKIT_NAMED_COMPUTATIONS=
# Off-only switches: a comma-separated list of ids, or for ordering any
# non-blank value. They can only turn something off.
# SIRKIT_ACQUISITION_DISABLED_SOURCES=
# SIRKIT_MANUFACTURING_DISABLED_PROVIDERS=
# SIRKIT_ORDERING_DISABLED=
# Rollout stages: off | observe | opt_in | authoritative_supported_profile.
# SIRKIT_MAPPING_STAGE4=
# SIRKIT_PASSIVE_POLICY_STAGE5=
# Shadows: on only when true.
# SIRKIT_FOOTPRINT_RESOLVER_SHADOW=
# SIRKIT_PHYSICAL_BINDING_SHADOW=
#
# Configuration (B24-A3, OD-197): the proxy header that keys the public
# per-client windows - x-real-ip, cf-connecting-ip, true-client-ip or
# fly-client-ip, and only behind a proxy that overwrites it. Unset: each
# public window is one bucket per process, shared by every caller.
# SIRKIT_TRUSTED_CLIENT_IP_HEADER=
