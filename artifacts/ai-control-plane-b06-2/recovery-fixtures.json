        "envelopeLineageId": "lin1-1234567890abcdef",
        "headSequence": 2,
        "headCanonicalDigest": "eng1-cccccccc22222222",
        "sequenceDigests": [
          "eng1-aaaaaaaa00000000",
          "eng1-bbbbbbbb11111111",
          "eng1-cccccccc22222222"
        ],
        "headUiDigest": "eng1-ffffffff00000000",
        "projectionDigest": "eng1-11ff11ff11ff11ff",
        "mark": {
          "lineageId": "lin1-1234567890abcdef",
          "headSequence": 2,
          "canonicalStateDigest": "eng1-dddddddd33333333"
        }
      },
      "decision": {
        "action": "conflict",
        "reason": "mark-digest-mismatch",
        "markStatus": "verified"
      }
    },
    {
      "scenarioId": "conflict-unverifiable-position",
      "description": "Older sequence whose digest matches no recorded log position — fabricated mark; fail closed.",
      "input": {
        "envelopeLineageId": "lin1-1234567890abcdef",
        "headSequence": 2,
        "headCanonicalDigest": "eng1-cccccccc22222222",
        "sequenceDigests": [
          "eng1-aaaaaaaa00000000",
          "eng1-bbbbbbbb11111111",
          "eng1-cccccccc22222222"
