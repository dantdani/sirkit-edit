{
  "schema": "sirkit.b06-3-lineage-recovery-fixtures.v1",
  "scenarios": [
    {
      "scenarioId": "conflict-foreign-mark-head-exact",
      "description": "THE B06.2-missed case: a FOREIGN-lineage mark whose sequence AND digest equal the envelope head, with differing projection content — never rebase-local-newer; conflict, both sides preserved.",
      "input": {
        "envelopeLineageId": "lin1-1234567890abcdef",
        "headSequence": 2,
        "headCanonicalDigest": "eng1-cccccccc22222222",
        "sequenceDigests": [
          "eng1-aaaaaaaa00000000",
          "eng1-bbbbbbbb11111111",
          "eng1-cccccccc22222222"
        ],
        "headUiDigest": "eng1-ffffffff00000000",
        "projectionDigest": "eng1-11ff11ff11ff11ff",
        "mark": {
          "lineageId": "lin1-feedfacefeedface",
          "headSequence": 2,
          "canonicalStateDigest": "eng1-cccccccc22222222"
        }
      },
      "decision": {
        "action": "conflict",
        "reason": "foreign-lineage-mark",
        "markStatus": "foreign-discarded"
      }
    },
    {
      "scenarioId": "conflict-foreign-mark-older-verified-position",
      "description": "A foreign-lineage mark naming a REAL older position of this lineage still conflicts — foreign marks are never verified-older evidence.",
      "input": {
        "envelopeLineageId": "lin1-1234567890abcdef",
        "headSequence": 2,
        "headCanonicalDigest": "eng1-cccccccc22222222",
        "sequenceDigests": [
          "eng1-aaaaaaaa00000000",
          "eng1-bbbbbbbb11111111",
          "eng1-cccccccc22222222"
        ],
        "headUiDigest": "eng1-ffffffff00000000",
        "projectionDigest": "eng1-11ff11ff11ff11ff",
        "mark": {
          "lineageId": "lin1-feedfacefeedface",
          "headSequence": 1,
          "canonicalStateDigest": "eng1-bbbbbbbb11111111"
        }
      },
      "decision": {
        "action": "conflict",
        "reason": "foreign-lineage-mark",
        "markStatus": "foreign-discarded"
      }
    },
    {
      "scenarioId": "resume-discards-foreign-mark",
      "description": "Projection content equals the canonical head but the mark is foreign — resume on the ENVELOPE lineage; the mark is discarded and the mismatch recorded.",
      "input": {
        "envelopeLineageId": "lin1-1234567890abcdef",
        "headSequence": 2,
        "headCanonicalDigest": "eng1-cccccccc22222222",
        "sequenceDigests": [
          "eng1-aaaaaaaa00000000",
          "eng1-bbbbbbbb11111111",
          "eng1-cccccccc22222222"
        ],
        "headUiDigest": "eng1-ffffffff00000000",
        "projectionDigest": "eng1-ffffffff00000000",
        "mark": {
          "lineageId": "lin1-feedfacefeedface",
          "headSequence": 2,
          "canonicalStateDigest": "eng1-cccccccc22222222"
        }
      },
      "decision": {
        "action": "resume",
        "markStatus": "foreign-discarded"
      }
    },
    {
      "scenarioId": "recover-when-lineage-unverifiable",
      "description": "Defensive: with no validated envelope lineage (migration could not run), a mark is never lineage evidence — untrusted projection, canonical wins.",
      "input": {
        "envelopeLineageId": null,
        "headSequence": 2,
        "headCanonicalDigest": "eng1-cccccccc22222222",
        "sequenceDigests": [
          "eng1-aaaaaaaa00000000",
          "eng1-bbbbbbbb11111111",
          "eng1-cccccccc22222222"
        ],
        "headUiDigest": "eng1-ffffffff00000000",
        "projectionDigest": "eng1-11ff11ff11ff11ff",
        "mark": {
          "lineageId": "lin1-1234567890abcdef",
          "headSequence": 2,
          "canonicalStateDigest": "eng1-cccccccc22222222"
        }
      },
      "decision": {
        "action": "recover-canonical",
        "reason": "untrusted-projection",
        "markStatus": "lineage-unverifiable"
      }
    }
  ],
  "markPersistence": [
    {
      "lifecycle": "unopened",
      "withMark": "(absent)",
      "result": "untouched"
    },
    {
      "lifecycle": "hydrating",
      "withMark": null,
      "result": "clears-mark"
    },
    {
      "lifecycle": "ready",
      "withMark": {
        "lineageId": "lin1-1234567890abcdef",
        "headSequence": 2,
        "canonicalStateDigest": "eng1-cccccccc22222222"
      },
      "result": "saves-mark"
    },
    {
      "lifecycle": "conflicted",
      "withMark": null,
      "result": "clears-mark"
    },
    {
      "lifecycle": "unavailable",
      "withMark": null,
      "result": "clears-mark"
    }
  ]
}
